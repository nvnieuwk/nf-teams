{
    "type": "message",
    "attachments": [
        {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "contentUrl": null,
            "content": {
                "\$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "msteams": {
                    "width": "Full"
                },
                "type": "AdaptiveCard",
                "version": "1.2",
                "body": [
                    {
                        "type": "TextBlock",
                        "size": "Large",
                        "weight": "Bolder",
                        "color": "${session.workflowMetadata.success ? 'good' : 'attention'}",
                        "text": "Completed: ${session.manifest.name} ${session.manifest.version} - ${session.workflowMetadata.runName}",
                        "wrap": true
                    },
                    {
                        "type": "TextBlock",
                        "spacing": "None",
                        "text": "Completed on ${session.workflowMetadata.complete} (${session.workflowMetadata.duration})",
                        "isSubtle": true,
                        "wrap": true
                    },
                    ${session.workflowMetadata.success ? '' : String.format('''
                    {
                        "type": "TextBlock",
                        "text": "The pipeline failed because of the following issue:",
                        "wrap": true
                    },
                    {
                        "type": "TextBlock",
                        "color": "attention",
                        "text": "%s",
                        "wrap": true
                    },''', session.workflowMetadata.errorMessage)}
                    {
                        "type": "TextBlock",
                        "text": "The pipeline ${session.workflowMetadata.success ? 'completed successfully' : 'failed'}.",
                        "wrap": true
                    },
                    {
                        "type": "TextBlock",
                        "text": "The command used to launch the workflow was as follows:",
                        "wrap": true
                    },
                    {
                        "type": "TextBlock",
                        "text": "${session.workflowMetadata.commandLine}",
                        "isSubtle": true,
                        "wrap": true
                    }
                ],
                "actions": [
                    {
                        "type": "Action.ShowCard",
                        "title": "Pipeline Configuration",
                        "card": {
                            "type": "AdaptiveCard",
                            "\$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                            "body": [
                                {
                                    "type": "FactSet",
                                    "facts": [
                                        {"title": "Pipeline start", "value":"${session.workflowMetadata.start}"},
                                        {"title": "Pipeline end", "value":"${session.workflowMetadata.complete}"},
                                        {"title": "Script file", "value":"${session.workflowMetadata.scriptFile}"},
                                        {"title": "Script ID", "value":"${session.workflowMetadata.scriptId}"},
                                        {"title": "Repository", "value":"${session.workflowMetadata.repository}"},
                                        {"title": "Revision", "value":"${session.workflowMetadata.revision}"},
                                        {"title": "Commit ID", "value":"${session.workflowMetadata.commitId}"},
                                        {"title": "Nextflow version", "value":"${session.workflowMetadata.nextflow.version}"},
                                        {"title": "Nextflow build", "value":"${session.workflowMetadata.nextflow.build}"},
                                        {"title": "Nextflow timestamp", "value":"${session.workflowMetadata.nextflow.timestamp}"}
                                    ]
                                }
                            ]
                        }
                    }
                ]
            }
        }
    ]
}